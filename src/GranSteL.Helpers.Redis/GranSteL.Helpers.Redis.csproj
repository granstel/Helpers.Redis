<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    
    <Title>Redis helpers</Title>
    <Description>
      RedisCacheService: a wrapper around StackExchange.Redis for caching raw strings and System.Text.Json values.
    </Description>

    <Authors>GranSteL</Authors>
    <PackageProjectUrl>https://github.com/granstel/Helpers.Redis</PackageProjectUrl>
    <RepositoryUrl>https://github.com/granstel/Helpers.Redis</RepositoryUrl>
    <RepositoryType>Github</RepositoryType>
    <PackageTags>Redis helper, serialization, cache, redis</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Language>C#</Language>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <Version>2.0.0</Version>
    <PackageReleaseNotes>Replace Newtonsoft.Json with System.Text.Json. See the README for migration details.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
    <PackageReference Include="StackExchange.Redis" Version="2.6.80" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>.</PackagePath>
    </None>
    <None Include="..\..\README.md" Pack="True" PackagePath="." />
  </ItemGroup>

</Project>
